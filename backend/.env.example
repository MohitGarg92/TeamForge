GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# Production uses MySQL to preserve login sessions across app restarts.
# Use TRUST_PROXY=1 behind Railway's HTTPS proxy.
# SESSION_STORE=mysql also enables database sessions during local testing.
